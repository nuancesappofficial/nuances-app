{
  "expo": {
    "name": "Nuances",
    "description": "AI-assisted English flashcards, pronunciation practice, and study tools built from text, images, and shared content.",
    "slug": "nuances-app",
    "scheme": "nuances",
    "version": "1.1.1",
    "orientation": "portrait",
    "icon": "./assets/app_icons/NUANCES_ICON8.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/app_icons/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#6DBCF6"
    },
    "ios": {
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.jeffenglishlearning.nuances",
      "buildNumber": "84",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Required to capture text or physical documents to create flashcards.",
        "NSPhotoLibraryUsageDescription": "Required to select existing images for custom flashcards.",
        "NSMicrophoneUsageDescription": "Required to record audio for pronunciation scoring and interactive feedback."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/app_icons/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.jeffenglishlearning.nuances",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/app_icons/favicon.png"
    },
    "plugins": [
      "expo-apple-authentication",
      "expo-camera",
      "expo-notifications",
      "./plugins/withShareExtension.js",
      "./plugins/withAndroidShareIntent.js",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.209409749377-go8sidkq8is8uecc76l7vl4ph6omot1r"
        }
      ],
      "./plugins/withGoogleSignInPodfile.js",
      "expo-video",
      "expo-secure-store",
      "expo-font",
      "expo-web-browser"
    ],
    "owner": "jeffenglishlearning",
    "extra": {
      "eas": {
        "projectId": "37bc7f3a-2135-4cb3-8e4d-4410603eb64a"
      }
    }
  }
}
