{
  "expo": {
    "name": "Nuances",
    "slug": "nuances-app",
    "scheme": "nuances",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app_icons/NUANCES_ICON8.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/app_icons/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jeffenglishlearning.nuances",
      "buildNumber": "2",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Required to capture text or physical documents to create flashcards.",
        "NSPhotoLibraryUsageDescription": "Required to select existing images for custom flashcards.",
        "NSMicrophoneUsageDescription": "Required to record audio for pronunciation scoring and interactive feedback."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/app_icons/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.jeffenglishlearning.nuances"
    },
    "web": {
      "favicon": "./assets/app_icons/favicon.png"
    },
    "plugins": [
      "expo-camera",
      "./plugins/withShareExtension.js"
    ],
    "owner": "jeffenglishlearning",
    "extra": {
      "eas": {
        "projectId": "37bc7f3a-2135-4cb3-8e4d-4410603eb64a"
      }
    }
  }
}
