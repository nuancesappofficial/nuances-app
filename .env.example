# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=your_supabase_project_url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# AI Proxy (Supabase Edge Function name)
EXPO_PUBLIC_AI_EDGE_FUNCTION_NAME=ai-proxy
EXPO_PUBLIC_DELETE_ACCOUNT_FUNCTION_NAME=delete-account

# Server-side fair-use quota defaults for Supabase Edge Function secrets.
# Set these with `supabase secrets set ...`; they are documented here for ops.
AI_DAILY_GENERATION_QUOTA=100
AI_WEEKLY_GENERATION_QUOTA=200
AI_MONTHLY_GENERATION_QUOTA=800
TTS_DAILY_QUOTA=100
TTS_WEEKLY_QUOTA=150
TTS_MONTHLY_QUOTA=500
PREMIUM_PRONUNCIATION_DAILY_QUOTA=60
PRONUNCIATION_WEEKLY_QUOTA=100
PRONUNCIATION_MONTHLY_QUOTA=300

# OAuth Redirect Scheme (must match app.json "scheme")
EXPO_PUBLIC_AUTH_REDIRECT_SCHEME=nuances

# Native Google Sign-In public OAuth client IDs
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_ios_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your_android_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_web_client_id.apps.googleusercontent.com

# RevenueCat public SDK keys (safe to embed; never put secret API keys here)
EXPO_PUBLIC_REVENUECAT_APPLE_API_KEY=appl_your_public_sdk_key
EXPO_PUBLIC_REVENUECAT_GOOGLE_API_KEY=goog_your_public_sdk_key
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=premium

# App Store update URL used as a fallback when remote version policy has no update_url
EXPO_PUBLIC_APP_STORE_URL=https://apps.apple.com/app/id6772143495

# Subscription development bypasses
EXPO_PUBLIC_SUBSCRIPTION_DEV_BYPASS=false
# EXPO_PUBLIC_SUBSCRIPTION_DEV_DEFAULT_PLAN must not be defined in production.

# Environment
NODE_ENV=development

# Privacy-first product analytics. It stays disabled unless this is true and a
# PostHog project key is present. Use the EU host for an EU PostHog project.
EXPO_PUBLIC_ANALYTICS_ENABLED=false
EXPO_PUBLIC_POSTHOG_API_KEY=phc_your_public_project_key
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Server-side Edge Function mirror for cost events.
POSTHOG_PROJECT_KEY=phc_your_public_project_key
POSTHOG_HOST=https://us.i.posthog.com

# Server-to-server token used by Xcode Archive Post-action to update app_version_policy.
# Set the same value in Supabase secrets as APP_VERSION_POLICY_SYNC_TOKEN.
APP_VERSION_POLICY_SYNC_TOKEN=replace_with_a_long_random_token
